# Database Configuration (MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=payments_db

# InfluxDB 3.x (metrics) - line protocol write API
INFLUX_URL=http://127.0.0.1:8181
INFLUX_TOKEN=your_influxdb3_admin_or_write_token
INFLUX_DB=billfold_metrics

# Sentry
SENTRY_DSN=

# Application Configuration
PORT=8080
GIN_MODE=release

# CORS - comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://billfold.ddns.net

# Security
JWT_SECRET=your-super-secret-key

